# Local development uses the persistent data/cinema.db file by default.
DATABASE_URL=file:./data/cinema.db
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password
NEXT_PUBLIC_CINEMA_TIME_ZONE=Asia/Kolkata

# For hosted deployment, set DATABASE_URL to your Turso libSQL URL
# and add TURSO_AUTH_TOKEN. Do not commit real credentials.
# TURSO_AUTH_TOKEN=
